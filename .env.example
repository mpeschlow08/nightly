# Runtime
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Core database
# Required (server-only): managed Postgres connection string.
# Source: Neon/Vercel/Azure Postgres connection details for each environment.
# Set separately for preview, staging, and production.
DATABASE_URL=
# Example format only (do not commit real credentials):
# DATABASE_URL=<SET_IN_DEPLOYMENT_ENVIRONMENT>

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_example
CLERK_SECRET_KEY=sk_test_example
CLERK_WEBHOOK_SECRET=whsec_example

# Google Places image and venue metadata import
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Optional but recommended for stable imported image storage
PUBLIC_BLOB_STORE_ID=your_vercel_blob_store_id
PUBLIC_BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token

# Security tokens
TICKET_TOKEN_SECRET=replace-with-strong-secret
SOCIAL_TOKEN_SECRET=replace-with-strong-secret

# Optional provider configuration
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_PROVIDER=
PUSH_PROVIDER=
SMS_PROVIDER=
REALTIME_PROVIDER=
VENUE_INTELLIGENCE_AI_PROVIDER=
VENUE_INTELLIGENCE_AI_KEY=
VENUE_OS_AI_PROVIDER=
ERROR_MONITORING_PROVIDER=none
JOB_SCHEDULER_PROVIDER=
WALLET_PASS_PROVIDER=
CAMERA_LIVE_PROVIDER=

# Development-only deterministic authenticated QA identities (never use in production)
E2E_CONSUMER_EMAIL=
E2E_DJ_EMAIL=
E2E_OWNER_EMAIL=
E2E_ADMIN_EMAIL=
E2E_LIMITED_ADMIN_EMAIL=
E2E_DOOR_EMAIL=
